<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to connectionStrings.config (git-ignored) and fill in. The TreeRecycle_ tables live in the KennelBooker database.
     Local test alternative: Server=(localdb)\TreeRecycle;Database=treerecycle;Integrated Security=True; -->
<connectionStrings>
  <add name="dbConnection" connectionString="Server=YOUR-SERVER;Database=pethotel;User Id=YOUR-USER;PWD=YOUR-PASSWORD;max pool size=100;" />
</connectionStrings>
