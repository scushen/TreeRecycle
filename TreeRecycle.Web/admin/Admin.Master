<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="TreeRecycle.Web.Admin.AdminMaster" %>
<!DOCTYPE html>
<html lang="en-IE">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title><%: Page.Title %> - Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600&family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="<%: ResolveUrl("~/css/site.css") %>?id=2" />
</head>
<body>
    <form id="form1" runat="server">
        <header class="topbar" style="background:#24302a">
            <div class="wrap">
                <a class="brand" href="<%: ResolveUrl("~/admin/") %>">
                    <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="#9fd1b3" d="M16 2 6 15h5l-6 8h8v7h6v-7h8l-6-8h5z"/></svg>
                    Platform admin
                </a>
                <nav class="nav">
                    <a href="<%: ResolveUrl("~/admin/") %>">Clubs</a>
                    <a href="<%: ResolveUrl("~/") %>" target="_blank">Public site</a>
                    <a href="<%: ResolveUrl("~/admin/logout.aspx") %>">Log out</a>
                </nav>
            </div>
        </header>
        <main>
            <div class="wrap">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </main>
    </form>
</body>
</html>
