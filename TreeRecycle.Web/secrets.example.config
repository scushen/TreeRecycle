<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to secrets.config (git-ignored). Any key here overrides the placeholder of the same name in Web.config.
     The file is optional: without it the site runs on Web.config's placeholders. -->
<appSettings>
  <add key="SiteUrl" value="https://REPLACE" />
  <add key="StripeSecretKey" value="sk_test_REPLACE" />
  <add key="StripeConnectWebhookSecret" value="whsec_REPLACE" />
  <add key="GoogleGeocodingApiKey" value="REPLACE" />
  <add key="PostmarkServerToken" value="REPLACE" />
  <add key="EmailFromAddress" value="collections@REPLACE.ie" />
  <add key="AdminNotifyEmail" value="REPLACE" />
</appSettings>
