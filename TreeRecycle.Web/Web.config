<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Secrets stay out of git. dbConnection is deliberately empty here: on Azure it comes from the App Service
       "Connection strings" setting of the same name; locally from the git-ignored connectionStrings.config
       (see BusinessObjectsFactory.GetConnectionString). Real keys go in Azure "App settings", or locally in the
       git-ignored secrets.config; either overrides the placeholders below. -->
  <connectionStrings>
    <add name="dbConnection" connectionString="" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings file="secrets.config">
    <add key="SiteName" value="TreeRecycle" />
    <add key="SiteUrl" value="http://localhost:8090" />
    <!-- Platform Stripe account (a separate account from KennelBooker - see README). sk_test_ while testing. -->
    
	  <add key="StripeSecretKey" value="sk_test_REPLACE" />
    <!-- whsec_ of the Connect webhook endpoint ("Listen to events on Connected accounts"). -->
    
	  <add key="StripeConnectWebhookSecret" value="whsec_REPLACE" />
    <!-- Our technology fee per tree, in euro. -->
    <add key="PlatformFeePerTree" value="2.00" />
    <!-- true = a refund from the club back office also refunds our fee. false = club bears it. -->
    
	<add key="RefundPlatformFee" value="false" />
    <add key="GoogleGeocodingApiKey" value="REPLACE" />
    <add key="PostmarkServerToken" value="REPLACE" />
    <add key="EmailFromAddress" value="collections@REPLACE.ie" />
	  
    <!-- Where "new club registered" alerts go. -->
    <add key="AdminNotifyEmail" value="REPLACE" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" />
    <!-- Markup files are UTF-8 without a BOM; without this ASP.NET reads them as ANSI and the euro sign breaks. -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="en-IE" uiCulture="en-IE" />
    <sessionState mode="InProc" timeout="60" cookieSameSite="Lax" />
    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Lax" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/error.aspx" />
    <pages controlRenderingCompatibilityVersion="4.0" clientIDMode="AutoID" validateRequest="true" />
  </system.web>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <defaultDocument>
      <files>
        <clear />
        <add value="default.aspx" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.ValueTuple" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Bcl.AsyncInterfaces" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.0" newVersion="10.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.1.6.0" newVersion="4.1.6.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Encodings.Web" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-9.0.0.0" newVersion="9.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-9.0.0.0" newVersion="9.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
