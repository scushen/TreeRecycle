<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Club.Master.cs" Inherits="TreeRecycle.Web.ClubArea.ClubMaster" %>
<!DOCTYPE html>
<html lang="en-IE">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title><%: Page.Title %> - <%: ClubName %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600&family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="<%: ResolveUrl("~/css/site.css") %>?id=4" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <header class="topbar">
            <div class="wrap">
                <a class="brand" href="<%: ResolveUrl("~/club/") %>">
                    <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="#9fd1b3" d="M16 2 6 15h5l-6 8h8v7h6v-7h8l-6-8h5z"/></svg>
                    <%: ClubName %>
                </a>
                <nav class="nav">
                    <%= NavLink("default.aspx", "Dashboard") %>
                    <%= NavLink("orders.aspx", "Orders") %>
                    <%= NavLink("routes.aspx", "Routes") %>
                    <%= NavLink("dates.aspx", "Collection dates") %>
                    <%= NavLink("prices.aspx", "Prices") %>
                    <%= NavLink("emails.aspx", "Emails") %>
                    <%= NavLink("money.aspx", "Money") %>
                    <%= NavLink("details.aspx", "Club details") %>
                    <%= NavLink("stripe.aspx", "Payments") %>
                    <a href="<%: ResolveUrl("~/club/logout.aspx") %>">Log out</a>
                </nav>
            </div>
        </header>
        <main>
            <div class="wrap">
                <asp:Literal ID="litStatusBanner" runat="server" />
                <% if (BookingUrl != "") { %>
                <div class="sharebar no-print">
                    <div class="sharebar-text">
                        <strong>Your booking page</strong>
                        <span><%: BookingIsLive
                            ? "Share this link on your website and socials so people can book a collection."
                            : "This is the link to share on your website and socials. It isn't taking bookings yet, but you can preview it while logged in." %></span>
                    </div>
                    <div class="sharebar-link">
                        <input type="text" id="shareUrl" readonly="readonly" value="<%: BookingUrl %>" onclick="this.select();" aria-label="Your booking page link" />
                        <button type="button" class="btn" onclick="copyShareUrl(this);">Copy link</button>
                        <a class="btn light" href="<%: BookingUrl %>" target="_blank" rel="noopener">Open page</a>
                    </div>
                </div>
                <script>
                    function copyShareUrl(btn) {
                        var box = document.getElementById('shareUrl');
                        var done = function () { btn.textContent = 'Copied'; setTimeout(function () { btn.textContent = 'Copy link'; }, 2000); };
                        if (navigator.clipboard && navigator.clipboard.writeText) {
                            navigator.clipboard.writeText(box.value).then(done, function () { box.select(); });
                        } else {
                            box.select();
                            try { document.execCommand('copy'); done(); } catch (e) { }
                        }
                    }
                </script>
                <% } %>
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </main>
    </form>
    <asp:ContentPlaceHolder ID="Scripts" runat="server" />
</body>
</html>
